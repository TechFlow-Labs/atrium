# Copy to .env.local. Generate secrets; do not reuse these placeholders.
# openssl rand -base64 32

DATABASE_URL=postgres://atrium_app:change-me@127.0.0.1:5432/atrium
DATABASE_URL_WORKER=postgres://atrium_worker:change-me@127.0.0.1:5432/atrium
DATABASE_URL_MIGRATE=postgres://atrium_migrator:change-me@127.0.0.1:5432/atrium

BETTER_AUTH_SECRET=replace-with-32-bytes-of-base64
BETTER_AUTH_URL=http://127.0.0.1:38471
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-bytes-of-base64

ALLOW_FAKE_PROVIDER=false
EMBEDDED_WORKER=false
NEXT_PUBLIC_APP_NAME=Atrium

# Optional OAuth. Leave unset to use a pasted access token instead.
# Callback URLs: {BETTER_AUTH_URL}/api/integrations/oauth/{provider}/callback
# Setup guide: docs/OAUTH.md — print URLs with: pnpm oauth:redirects
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITEA_CLIENT_ID=
# GITEA_CLIENT_SECRET=
# Optional: OAuth target for self-hosted Gitea (defaults to https://gitea.com)
# GITEA_SITE_URL=https://gitea.example.com

# Password reset email. Leave unset in local development to print the reset link in the server log.
# Production uses the shared Techflow mailbox on linux230.papaki.gr, port 465 (implicit TLS).
# SMTP_HOST=linux230.papaki.gr
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=support@techflowlabs.gr
# SMTP_PASSWORD=
# SMTP_FROM=Atrium <support@techflowlabs.gr>

# Obsidian Self-hosted LiveSync filesystem mirrors (colon-separated absolute roots).
# Required when connecting Obsidian with a vault path such as /root/vaults/THEVAULT.
# Example: OBSIDIAN_VAULT_ROOT=/root/vaults:/opt/obsidian-livesync/vaults
# OBSIDIAN_VAULT_ROOT=
